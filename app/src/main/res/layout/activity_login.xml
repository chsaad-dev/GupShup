<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Header Area -->
        <LinearLayout
            android:id="@+id/topHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_2xl"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Monogram Avatar: 64dp, Primary Container background, brand-colored "G" -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logoCard"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="@dimen/elevation_level_0"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/colorPrimaryContainer">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="G"
                    style="@style/TextAppearance.GupShup.Headline"
                    android:textSize="32sp"
                    android:textColor="@color/colorPrimary"
                    android:gravity="center" />
            </com.google.android.material.card.MaterialCardView>

            <!-- App Title: Headline Style -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GupShup"
                style="@style/TextAppearance.GupShup.Headline"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="@dimen/spacing_sm" />
        </LinearLayout>

        <!-- Form Container Sheet: Rising from bottom, 24dp top corner radius only, Surface Container Low background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_3xl"
            app:cardElevation="@dimen/elevation_level_1"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/colorSurfaceContainerLow"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GupShup.TopSheet"
            app:layout_constraintTop_toBottomOf="@id/topHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_2xl">

                <!-- Headline -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    style="@style/TextAppearance.GupShup.Headline" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to your account"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:layout_marginBottom="@dimen/spacing_xl" />

                <!-- Email Field (Widget.GupShup.TextField style) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    style="@style/Widget.GupShup.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email address"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/onSurfaceVariant"
                    app:errorEnabled="true"
                    app:errorTextAppearance="@style/TextAppearance.GupShup.Caption">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        style="@style/TextAppearance.GupShup.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Field (Widget.GupShup.TextField style, 16dp gap) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    style="@style/Widget.GupShup.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:hint="Password"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/onSurfaceVariant"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/onSurfaceVariant"
                    app:errorEnabled="true"
                    app:errorTextAppearance="@style/TextAppearance.GupShup.Caption">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        style="@style/TextAppearance.GupShup.Body" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot Password Link -->
                <TextView
                    android:id="@+id/forgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot password?"
                    style="@style/TextAppearance.GupShup.Label"
                    android:textColor="@color/colorPrimary"
                    android:layout_gravity="end"
                    android:padding="@dimen/spacing_xs"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <!-- Primary Sign In Button: Widget.GupShup.Button.Filled, 24dp top margin -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    style="@style/Widget.GupShup.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/spacing_2xl"
                    android:text="Sign In" />

                <!-- Progress Indicator -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressIndicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:visibility="gone"
                    app:indicatorColor="@color/colorPrimary" />

                <!-- OR Divider Row -->
                <LinearLayout
                    android:id="@+id/orDivider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:layout_marginBottom="@dimen/spacing_xl">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/outline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OR"
                        style="@style/TextAppearance.GupShup.Caption"
                        android:paddingHorizontal="@dimen/spacing_sm" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <!-- Google Sign-In Button (Outlined variant, 14dp radius, 52dp height) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/googleSignInButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Continue with Google"
                    android:textAppearance="@style/TextAppearance.GupShup.Label"
                    android:textColor="?attr/colorOnSurface"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/spacing_md"
                    app:iconSize="20dp"
                    app:iconTint="@null"
                    app:cornerRadius="@dimen/radius_medium"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp" />

                <!-- Register Link Row: 16dp bottom margin -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_2xl"
                    android:layout_marginBottom="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Don't have an account? "
                        style="@style/TextAppearance.GupShup.Body"
                        android:textColor="@color/onSurfaceVariant" />

                    <TextView
                        android:id="@+id/goToRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign up"
                        style="@style/TextAppearance.GupShup.Body"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:padding="@dimen/spacing_xs"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
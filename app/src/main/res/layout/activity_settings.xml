<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Material 3 Toolbar (Surface-toned) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Settings"
        app:titleTextAppearance="@style/TextAppearance.GupShup.Headline"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface" />

    <!-- Scrollable Settings List -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_3xl">

            <!-- SECTION 1: ACCOUNT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT"
                style="@style/TextAppearance.GupShup.Label"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <!-- Profile Row -->
            <LinearLayout
                android:id="@+id/rowProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/onSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile"
                        style="@style/TextAppearance.GupShup.Body" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit profile picture, name, and bio"
                        style="@style/TextAppearance.GupShup.Caption"
                        android:textColor="@color/onSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Privacy Row -->
            <LinearLayout
                android:id="@+id/rowPrivacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/onSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy"
                        style="@style/TextAppearance.GupShup.Body" />

                    <TextView
                        android:id="@+id/textPrivacySummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Who can see online status &amp; last seen"
                        style="@style/TextAppearance.GupShup.Caption"
                        android:textColor="@color/onSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Blocked Contacts Row -->
            <LinearLayout
                android:id="@+id/rowBlocked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person_placeholder"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Blocked contacts"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textBlockedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>


            <!-- SECTION 2: NOTIFICATIONS (24dp top margin) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATIONS"
                style="@style/TextAppearance.GupShup.Label"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <!-- Message Notifications Switch Row -->
            <LinearLayout
                android:id="@+id/rowMessageNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Message notifications"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMessageNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Notification Sound Row -->
            <LinearLayout
                android:id="@+id/rowNotificationSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notification sound"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textNotificationSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Vibrate Switch Row -->
            <LinearLayout
                android:id="@+id/rowVibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vibrate"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchVibrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>


            <!-- SECTION 3: CHAT (24dp top margin) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHAT"
                style="@style/TextAppearance.GupShup.Label"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <!-- Theme Selector Row -->
            <LinearLayout
                android:id="@+id/rowTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="App theme"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Wallpaper Row -->
            <LinearLayout
                android:id="@+id/rowWallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chat_empty"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chat wallpaper"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textWallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Font Size Row -->
            <LinearLayout
                android:id="@+id/rowFontSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Font size"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textFontSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Enter Key Sends Switch Row -->
            <LinearLayout
                android:id="@+id/rowEnterSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enter key sends message"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnterSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>


            <!-- SECTION 4: DATA & STORAGE (24dp top margin) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA &amp; STORAGE"
                style="@style/TextAppearance.GupShup.Label"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <!-- Media Auto Download Row -->
            <LinearLayout
                android:id="@+id/rowMediaDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_add_status"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Media auto-download"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi &amp; Mobile"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Storage Usage Row -->
            <LinearLayout
                android:id="@+id/rowStorageUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Storage usage"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textStorageUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="245 MB"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>


            <!-- SECTION 5: HELP & ABOUT (24dp top margin) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HELP &amp; ABOUT"
                style="@style/TextAppearance.GupShup.Label"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <!-- Help Center Row -->
            <LinearLayout
                android:id="@+id/rowHelpCenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Help center"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- Report a Problem Row -->
            <LinearLayout
                android:id="@+id/rowReportProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Report a problem"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- App Version Row (not clickable) -->
            <LinearLayout
                android:id="@+id/rowAppVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/onSurfaceVariant" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="App version"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0.0"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/outline"
                android:layout_marginStart="56dp" />

            <!-- User ID Row -->
            <LinearLayout
                android:id="@+id/rowUserId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/onSurfaceVariant"
                    android:contentDescription="User ID Icon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User ID"
                    style="@style/TextAppearance.GupShup.Body"
                    android:layout_marginStart="@dimen/spacing_lg" />

                <TextView
                    android:id="@+id/textUserId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    style="@style/TextAppearance.GupShup.Caption"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:ellipsize="middle"
                    android:maxEms="10"
                    android:singleLine="true" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/onSurfaceVariant"
                    android:contentDescription="Copy User ID" />
            </LinearLayout>


            <!-- ACCOUNT ACTIONS SECTION (32dp top margin) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_2xl"
                android:layout_marginTop="@dimen/spacing_3xl">

                <!-- Logout Button: Outlined error-colored button style, full width -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettingsLogout"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="Logout"
                    android:textAppearance="@style/TextAppearance.GupShup.Label"
                    android:textColor="@color/error"
                    android:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_logout"
                    app:iconGravity="textStart"
                    app:iconTint="@color/error"
                    app:strokeColor="@color/error"
                    app:strokeWidth="1dp"
                    app:cornerRadius="@dimen/radius_medium" />

                <!-- Delete Account Text: Plain error-colored text row, less prominent than Logout -->
                <TextView
                    android:id="@+id/textDeleteAccount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="Delete account"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/error"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

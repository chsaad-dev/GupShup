<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:fitsSystemWindows="false">

    <!-- Center Content Stack -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo: Circular White Surface (96dp) with Soft Shadow (Elevation Level 2 = 3dp) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/splashLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardCornerRadius="48dp"
            app:cardElevation="@dimen/elevation_level_2"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="G"
                style="@style/TextAppearance.GupShup.Headline"
                android:textSize="40sp"
                android:textColor="@color/colorPrimary"
                android:gravity="center" />
        </com.google.android.material.card.MaterialCardView>

        <!-- App Name: GupShup (Display style, White, Tight letter spacing) -->
        <TextView
            android:id="@+id/splashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GupShup"
            style="@style/TextAppearance.GupShup.Display"
            android:textColor="@color/white"
            android:layout_marginTop="@dimen/spacing_xl"
            android:alpha="0" />

        <!-- Tagline: Connect with friends (Body style, White at 80% opacity) -->
        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect with friends"
            style="@style/TextAppearance.GupShup.Body"
            android:textColor="#CCFFFFFF"
            android:layout_marginTop="@dimen/spacing_sm"
            android:alpha="0" />

    </LinearLayout>

    <!-- Bottom: Thin Circular Progress Indicator (White, 3dp stroke, 64dp from bottom) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/splashProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="64dp"
        android:indeterminate="true"
        app:indicatorColor="@color/white"
        app:trackColor="#33FFFFFF"
        app:indicatorSize="32dp"
        app:trackThickness="3dp"
        android:alpha="0" />

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Full-bleed status media image view -->
    <ImageView
        android:id="@+id/statusImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="Status Media"
        android:visibility="gone" />

    <!-- Centered text for text-only status -->
    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:paddingHorizontal="32dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Top Gradient Scrim Overlay -->
    <View
        android:id="@+id/topScrim"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_story_top_scrim" />

    <!-- Top Header Layout sitting ON the top scrim -->
    <LinearLayout
        android:id="@+id/topHeaderContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:paddingTop="12dp"
        android:paddingHorizontal="12dp">

        <!-- Segmented Progress Bar Container -->
        <LinearLayout
            android:id="@+id/segmentedProgressBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp" />

        <!-- Header Bar: Back, Avatar, Name+Time, Delete -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white"
                android:contentDescription="Back" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/headerAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_toEndOf="@id/backButton"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_profile_placeholder"
                app:civ_border_width="1.5dp"
                app:civ_border_color="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/headerAvatar"
                android:layout_toStartOf="@id/deleteStatusButton"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/timestampTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h ago"
                    style="@style/TextAppearance.GupShup.Caption"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/deleteStatusButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_delete"
                app:tint="@color/white"
                android:visibility="gone"
                android:contentDescription="Delete Status" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Bottom Gradient Scrim Overlay -->
    <View
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_story_bottom_scrim" />

    <!-- Bottom Content Overlay sitting ON the bottom scrim -->
    <LinearLayout
        android:id="@+id/bottomContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <!-- Plain White Caption Text (No bubble/pill container) -->
        <TextView
            android:id="@+id/statusCaptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.GupShup.Body"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:maxLines="4"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Owner-only Viewers Count Button -->
        <LinearLayout
            android:id="@+id/viewersCountContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_rounded_gray"
            android:backgroundTint="#40FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_eye"
                app:tint="@color/white"
                android:contentDescription="Viewers Icon" />

            <TextView
                android:id="@+id/viewersCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="0"
                style="@style/TextAppearance.GupShup.Caption"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="24dp">

    <!-- Handle Bar for BottomSheet -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/outline"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report a Problem"
        style="@style/TextAppearance.GupShup.Headline"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Help us improve GupShup by describing the issue."
        style="@style/TextAppearance.GupShup.Body"
        android:textColor="@color/onSurfaceVariant"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Issue Category"
                style="@style/TextAppearance.GupShup.Label"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/radioGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radioBug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bug Report / App Crash"
                    android:checked="true"
                    style="@style/TextAppearance.GupShup.Body" />

                <RadioButton
                    android:id="@+id/radioFeature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Feature Request"
                    style="@style/TextAppearance.GupShup.Body" />

                <RadioButton
                    android:id="@+id/radioPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Account &amp; Privacy"
                    style="@style/TextAppearance.GupShup.Body" />

                <RadioButton
                    android:id="@+id/radioOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Other"
                    style="@style/TextAppearance.GupShup.Body" />
            </RadioGroup>

            <!-- Problem Description Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutDescription"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe the problem..."
                android:textColorHint="@color/onSurfaceVariant"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:maxLines="8"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/onSurfaceVariant"
                    style="@style/TextAppearance.GupShup.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitReport"
                style="@style/Widget.GupShup.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Submit Report"
                android:layout_marginTop="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

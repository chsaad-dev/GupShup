<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingBottom="@dimen/spacing_2xl">

    <!-- Top Drag Handle bar -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/bg_rounded_gray" />

    <!-- Title Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_sm">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_eye"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/viewersTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Viewed by 0"
            style="@style/TextAppearance.GupShup.Headline"
            android:layout_marginStart="@dimen/spacing_md" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_sm" />

    <!-- Viewers List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/viewersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/emptyViewersText"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No views yet"
        style="@style/TextAppearance.GupShup.Body"
        android:textColor="@color/onSurfaceVariant"
        android:visibility="gone" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_2xl">

    <!-- Drag Handle Indicator -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginBottom="@dimen/spacing_md"
        android:background="@drawable/rounded_image_bg"
        android:backgroundTint="@color/outline" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Privacy Settings"
        style="@style/TextAppearance.GupShup.Headline"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control who can see your activity and info"
        style="@style/TextAppearance.GupShup.Caption"
        android:textColor="@color/onSurfaceVariant"
        android:layout_marginBottom="@dimen/spacing_lg" />

    <!-- Row 1: Online Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/spacing_xs">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/online_indicator_dot"
            app:tint="@color/onSurfaceVariant"
            android:contentDescription="Online Status Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online Status"
                style="@style/TextAppearance.GupShup.Body" />

            <TextView
                android:id="@+id/textSubtitleOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visible to everyone"
                style="@style/TextAppearance.GupShup.Caption"
                android:textColor="@color/onSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchOnlineStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline"
        android:layout_marginStart="48dp" />

    <!-- Row 2: Last Seen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/spacing_xs">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_info"
            app:tint="@color/onSurfaceVariant"
            android:contentDescription="Last Seen Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Seen Time"
                style="@style/TextAppearance.GupShup.Body" />

            <TextView
                android:id="@+id/textSubtitleLastSeen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visible to everyone"
                style="@style/TextAppearance.GupShup.Caption"
                android:textColor="@color/onSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchLastSeen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline"
        android:layout_marginStart="48dp" />

    <!-- Row 3: Profile Photo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/spacing_xs">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person"
            app:tint="@color/onSurfaceVariant"
            android:contentDescription="Profile Photo Privacy Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile Photo"
                style="@style/TextAppearance.GupShup.Body" />

            <TextView
                android:id="@+id/textSubtitlePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visible to everyone"
                style="@style/TextAppearance.GupShup.Caption"
                android:textColor="@color/onSurfaceVariant" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchProfilePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

</LinearLayout>

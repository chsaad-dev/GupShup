<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- AppBar & Large Prominent Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="@dimen/elevation_level_0">

        <!-- Toolbar with "Chats" Display Title left-aligned and Search icon right side -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/homeToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="Chats"
            app:titleTextAppearance="@style/TextAppearance.GupShup.Display"
            app:titleTextColor="?attr/colorOnSurface"
            app:titleCentered="false"
            app:menu="@menu/home_menu" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Container with Pull-to-Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Shimmer Loading Placeholder -->
            <include
                android:id="@+id/shimmerPlaceholder"
                layout="@layout/shimmer_home_placeholder" />

            <!-- Actual RecyclerView for Chats -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="88dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <!-- Empty State View (Widget.GupShup.EmptyState style) -->
            <LinearLayout
                android:id="@+id/emptyStateView"
                style="@style/Widget.GupShup.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <com.example.gupshup.ui.view.ModernAnimatedEmptyView
                    android:id="@+id/chatsAnimatedEmptyView"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:iconSrc="@drawable/ic_chat_empty"
                    app:pulseColor="@color/colorPrimary" />

                <!-- Title: Headline Style -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No conversations yet"
                    style="@style/TextAppearance.GupShup.Headline"
                    android:layout_marginTop="@dimen/spacing_2xl" />

                <!-- Subtitle: Body Style in OnSurfaceVariant -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start chatting with friends"
                    style="@style/TextAppearance.GupShup.Body"
                    android:textColor="@color/onSurfaceVariant"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textAlignment="center" />
            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- FAB: Bottom-right, 56dp, Primary background, Level 2 elevation, Pencil/Chat icon, 16dp margin -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNewChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/spacing_lg"
        android:layout_marginBottom="84dp"
        android:src="@drawable/ic_edit"
        app:fabSize="normal"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/white"
        app:elevation="@dimen/elevation_level_2"
        android:contentDescription="Start new chat" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

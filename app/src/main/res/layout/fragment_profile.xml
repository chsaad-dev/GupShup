<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Material 3 Toolbar (Surface-toned) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/profileToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Profile"
        app:titleTextAppearance="@style/TextAppearance.GupShup.Headline"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:menu="@menu/profile_menu" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_3xl">

            <!-- Header Stack: 110dp Vertical Gradient background block with overlapping 100dp Avatar (no pencil badge) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="160dp">

                <!-- 110dp Gradient Visual Anchor Block (fading from Primary Container into Surface color) -->
                <View
                    android:id="@+id/headerBlock"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_profile_header_gradient" />

                <!-- Avatar Stack (100dp circular, 4dp Surface ring, center sitting ON 110dp boundary at top 60dp) -->
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="60dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- 100dp Avatar with 4dp Surface ring -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeWidth="4dp"
                        app:strokeColor="?attr/colorSurface" />
                </FrameLayout>
            </RelativeLayout>

            <!-- Name: Headline style (22sp SemiBold), centered, 12dp below avatar -->
            <TextView
                android:id="@+id/profileNameHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                style="@style/TextAppearance.GupShup.Headline"
                android:textColor="?attr/colorOnSurface"
                android:textAlignment="center" />

            <!-- Content Area: 16dp side margins -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- "ACCOUNT INFO" label: Label style, brand color (#128C7E), uppercase, left-aligned, 24dp top margin -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT INFO"
                    style="@style/TextAppearance.GupShup.Label"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <!-- Plain Read-Style Row 1: Full Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/onSurfaceVariant"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Full Name Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Name"
                            style="@style/TextAppearance.GupShup.Caption"
                            android:textColor="@color/onSurfaceVariant" />

                        <EditText
                            android:id="@+id/nameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:padding="0dp"
                            android:inputType="textPersonName"
                            style="@style/TextAppearance.GupShup.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:enabled="false" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <!-- Plain Read-Style Row 2: Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_email"
                        app:tint="@color/onSurfaceVariant"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Email Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            style="@style/TextAppearance.GupShup.Caption"
                            android:textColor="@color/onSurfaceVariant" />

                        <EditText
                            android:id="@+id/emailEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:padding="0dp"
                            android:inputType="textEmailAddress"
                            style="@style/TextAppearance.GupShup.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:enabled="false" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <!-- Plain Read-Style Row 3: Bio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/onSurfaceVariant"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Bio Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bio"
                            style="@style/TextAppearance.GupShup.Caption"
                            android:textColor="@color/onSurfaceVariant" />

                        <EditText
                            android:id="@+id/bioEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:padding="0dp"
                            android:inputType="textMultiLine"
                            android:maxLines="3"
                            style="@style/TextAppearance.GupShup.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:enabled="false" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <!-- Edit Profile Button: Widget.GupShup.Button.Filled style, full width, 16dp side margins, 24dp top margin -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editSaveButton"
                    style="@style/Widget.GupShup.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="24dp"
                    android:text="Edit Profile"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconTint="@color/white" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Material 3 Toolbar (Surface-toned) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/profileToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Profile"
        app:titleTextAppearance="@style/TextAppearance.GupShup.Headline"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:menu="@menu/profile_menu" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_3xl">

            <!-- Header Stack: Gradient cover header with overlapping Avatar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="160dp">

                <View
                    android:id="@+id/headerBlock"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_profile_header_gradient" />

                <!-- Avatar Stack (100dp circular avatar sitting ON 110dp boundary) -->
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="58dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Outer Status Ring Overlay (Visible when active status exists) -->
                    <View
                        android:id="@+id/statusRingView"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:background="@drawable/status_ring"
                        android:visibility="gone" />

                    <!-- 96dp Avatar with 4dp Surface ring -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileImageView"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile_placeholder"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeWidth="3dp"
                        app:strokeColor="?attr/colorSurface" />

                    <!-- Camera Edit Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cameraBadge"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        app:cardCornerRadius="15dp"
                        app:cardBackgroundColor="@color/colorPrimary"
                        app:cardElevation="4dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="?attr/colorSurface">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white"
                            android:contentDescription="Change Photo" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </RelativeLayout>

            <!-- Name: Headline style (22sp SemiBold), centered -->
            <TextView
                android:id="@+id/profileNameHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                style="@style/TextAppearance.GupShup.Headline"
                android:textColor="?attr/colorOnSurface"
                android:textAlignment="center" />

            <!-- Friends count + Member since stat row -->
            <TextView
                android:id="@+id/profileStatsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                style="@style/TextAppearance.GupShup.Caption"
                android:textColor="@color/onSurfaceVariant"
                android:textAlignment="center"
                android:text="0 friends · Member since..." />

            <!-- Action Chips Row (QR code & Copy link) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qrCodeChip"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="QR code"
                    android:textAppearance="@style/TextAppearance.GupShup.Label"
                    android:textColor="?attr/colorOnSurface"
                    app:icon="@drawable/ic_logo"
                    app:iconTint="?attr/colorOnSurface"
                    app:iconSize="18dp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    android:layout_marginEnd="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyLinkChip"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Copy link"
                    android:textAppearance="@style/TextAppearance.GupShup.Label"
                    android:textColor="?attr/colorOnSurface"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="?attr/colorOnSurface"
                    app:iconSize="18dp"
                    app:cornerRadius="20dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Content Area: 16dp side margins -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- "ACCOUNT INFO" label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACCOUNT INFO"
                    style="@style/TextAppearance.GupShup.Label"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <!-- Row 1: Full Name (Inline Editing Support) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_person"
                        app:tint="@color/onSurfaceVariant"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Full Name Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full name"
                            style="@style/TextAppearance.GupShup.Caption"
                            android:textColor="@color/onSurfaceVariant" />

                        <TextView
                            android:id="@+id/nameTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.GupShup.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                        <EditText
                            android:id="@+id/nameEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_pill"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:inputType="textPersonName"
                            style="@style/TextAppearance.GupShup.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:visibility="gone"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/editNameButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/onSurfaceVariant"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="Edit Full Name" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <!-- Row 2: Email (Display Only) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_email"
                        app:tint="@color/onSurfaceVariant"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Email Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            style="@style/TextAppearance.GupShup.Caption"
                            android:textColor="@color/onSurfaceVariant" />

                        <TextView
                            android:id="@+id/emailTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.GupShup.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <!-- Row 3: Bio (Inline Editing + Counter + Emoji) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/onSurfaceVariant"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="Bio Icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bio"
                            style="@style/TextAppearance.GupShup.Caption"
                            android:textColor="@color/onSurfaceVariant" />

                        <!-- Display mode text -->
                        <TextView
                            android:id="@+id/bioTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/TextAppearance.GupShup.Body"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="2dp" />

                        <!-- Inline Edit mode container -->
                        <LinearLayout
                            android:id="@+id/bioEditContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_marginTop="4dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <EditText
                                    android:id="@+id/bioEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_input_pill"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="40dp"
                                    android:paddingVertical="8dp"
                                    android:inputType="textMultiLine"
                                    android:maxLines="3"
                                    style="@style/TextAppearance.GupShup.Body"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageView
                                    android:id="@+id/bioEmojiButton"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:layout_marginEnd="8dp"
                                    android:padding="2dp"
                                    android:src="@drawable/ic_send"
                                    app:tint="@color/colorPrimary"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:contentDescription="Pick Emoji" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/bioCharCounterText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:text="0/150"
                                style="@style/TextAppearance.GupShup.Caption"
                                android:textColor="@color/onSurfaceVariant"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/editBioButton"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/onSurfaceVariant"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="2dp"
                        android:layout_marginStart="12dp"
                        android:contentDescription="Edit Bio" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline" />

                <!-- Row 4: Invite friends to GupShup -->
                <LinearLayout
                    android:id="@+id/rowInviteFriends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="16dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_friends"
                        app:tint="@color/onSurfaceVariant"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Invite Friends Icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Invite friends to GupShup"
                        style="@style/TextAppearance.GupShup.Body"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/onSurfaceVariant"
                        android:contentDescription="Chevron" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

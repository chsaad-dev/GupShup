<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Material 3 Toolbar (Surface-toned) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/searchToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="Search Users"
        app:titleTextAppearance="@style/TextAppearance.GupShup.Headline"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface" />

    <!-- Pill-shaped Search Bar Container (48dp height, 28dp radius, Surface Container High, no border, 16dp side margins) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_md"
        android:background="?attr/colorSurface">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_pill"
            app:boxBackgroundMode="none"
            app:hintAnimationEnabled="false"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/onSurfaceVariant"
            app:endIconMode="clear_text"
            app:endIconTint="@color/onSurfaceVariant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Search by name or email"
                android:inputType="text"
                android:maxLines="1"
                android:background="@null"
                android:paddingVertical="0dp"
                style="@style/TextAppearance.GupShup.Body" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Main Results / Empty Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Search Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/spacing_lg"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <!-- Intentional Empty / Initial State (Widget.GupShup.EmptyState style) -->
        <LinearLayout
            android:id="@+id/searchEmptyState"
            style="@style/Widget.GupShup.EmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_3xl">

            <com.example.gupshup.ui.view.ModernAnimatedEmptyView
                android:id="@+id/searchAnimatedEmptyView"
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:iconSrc="@drawable/ic_search"
                app:pulseColor="@color/colorPrimary" />

            <!-- Title: Headline Style -->
            <TextView
                android:id="@+id/searchEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search for users"
                style="@style/TextAppearance.GupShup.Headline"
                android:layout_marginTop="@dimen/spacing_2xl" />

            <!-- Subtitle: Body Style in OnSurfaceVariant -->
            <TextView
                android:id="@+id/searchEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Find friends by name or email"
                style="@style/TextAppearance.GupShup.Body"
                android:textColor="@color/onSurfaceVariant"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAlignment="center" />
        </LinearLayout>

    </FrameLayout>
</LinearLayout>

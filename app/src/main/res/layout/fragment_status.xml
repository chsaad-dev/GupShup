<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/statusToolbar"
        android:layout_width="0dp"
        android:layout_height="63dp"
        android:background="@color/colorPrimary"
        android:title="Status"
        android:titleTextColor="@android:color/white"
        app:titleCentered="true"
        app:navigationIcon="@drawable/ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bubbles RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/statusBubbleRecyclerView"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:clipToPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/statusToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"/>

    <!-- Input card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusInputCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusBubbleRecyclerView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/primaryColor"
        app:strokeWidth="1dp"
        android:backgroundTint="@android:color/white">

        <EditText
            android:id="@+id/statusEditText"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Share your thoughts..."
            android:textColor="#212121"
            android:textSize="15sp"
            android:gravity="top|start"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:maxLines="5"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Post Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/postStatusButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Post Status"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/colorPrimary"
        app:cornerRadius="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/statusInputCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- RecyclerView for status list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/statusRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/postStatusButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingVertical="2dp"
    android:paddingHorizontal="@dimen/spacing_sm">

    <!-- Received Message Card Bubble: 18dp radius with bottom-left 4dp tail, Level 1 elevation -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bubbleReceived"
        app:cardElevation="@dimen/elevation_level_1"
        app:strokeWidth="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GupShup.Bubble.Received"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="48dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:minWidth="80dp">

            <!-- Message Image (200dp max height, 14dp corner radius, tap to expand) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/messageImage"
                android:layout_width="220dp"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_xs"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Message Text: Body Style -->
            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.GupShup.Body"
                android:textColor="@color/bubbleReceivedText" />

            <!-- Timestamp: Caption Style bottom-right inside bubble -->
            <TextView
                android:id="@+id/messageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.GupShup.Caption"
                android:textColor="@color/onSurfaceVariant"
                android:layout_gravity="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Reaction Bubble: Small pill overlapping bottom-left corner, Surface + 1dp shadow, Caption style -->
    <TextView
        android:id="@+id/reactionView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.GupShup.Caption"
        android:background="@drawable/bg_reaction_pill"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="-8dp"
        android:layout_marginStart="@dimen/spacing_sm"
        android:elevation="@dimen/elevation_level_1"
        android:visibility="gone" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingVertical="2dp"
    android:paddingHorizontal="@dimen/spacing_sm">

    <!-- Sent Message Card Bubble: 18dp radius with bottom-right 4dp tail, max width 78% of screen -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bubbleSent"
        app:cardElevation="@dimen/elevation_level_0"
        app:strokeWidth="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GupShup.Bubble.Sent"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:minWidth="80dp">

            <!-- Message Image (200dp max height, 14dp corner radius, tap to expand) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/messageImage"
                android:layout_width="220dp"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_xs"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Message Text: Body Style -->
            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.GupShup.Body"
                android:textColor="@color/bubbleSentText" />

            <!-- Timestamp & Status Ticks: Caption Style, 70% opacity -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/messageStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance.GupShup.Caption"
                    android:textColor="#B30B141A"
                    android:layout_marginEnd="2dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Reaction Bubble: Small pill overlapping bottom-right corner, Surface + 1dp shadow, Caption style -->
    <TextView
        android:id="@+id/reactionView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.GupShup.Caption"
        android:background="@drawable/bg_reaction_pill"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:elevation="@dimen/elevation_level_1"
        android:visibility="gone" />

</LinearLayout>

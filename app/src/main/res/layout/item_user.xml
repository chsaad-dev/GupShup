<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/spacing_lg">

    <!-- Avatar Container (52dp x 52dp) with 14dp Online Indicator Dot at bottom-right -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/userImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <!-- Online Indicator: 14dp Green Dot with 2dp White Ring stroke -->
        <View
            android:id="@+id/onlineIndicator"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/online_indicator_dot"
            android:visibility="gone" />
    </FrameLayout>

    <!-- User Name: Title Style -->
    <TextView
        android:id="@+id/userName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Username"
        style="@style/TextAppearance.GupShup.Title"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_sm"
        app:layout_constraintStart_toEndOf="@id/avatarContainer"
        app:layout_constraintTop_toTopOf="@id/avatarContainer"
        app:layout_constraintEnd_toStartOf="@id/unreadCountText" />

    <!-- Last Message / Email Preview: Body Style, OnSurfaceVariant, 1 line ellipsis -->
    <TextView
        android:id="@+id/userEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Message preview..."
        style="@style/TextAppearance.GupShup.Body"
        android:textColor="@color/onSurfaceVariant"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_sm"
        app:layout_constraintStart_toEndOf="@id/avatarContainer"
        app:layout_constraintTop_toBottomOf="@id/userName"
        app:layout_constraintEnd_toStartOf="@id/unreadCountText" />

    <!-- Unread Badge: Brand-colored Pill, min 20dp, Label style white text, 6dp horizontal padding -->
    <TextView
        android:id="@+id/unreadCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="20dp"
        android:minHeight="20dp"
        android:background="@drawable/bg_unread_badge"
        android:text="1"
        style="@style/TextAppearance.GupShup.Label"
        android:textColor="@color/white"
        android:gravity="center"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/avatarContainer"
        app:layout_constraintBottom_toBottomOf="@id/avatarContainer" />

    <!-- Action Buttons for Search / Friend Requests (Preserved IDs, default gone) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addFriendBtn"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Add"
        android:textAppearance="@style/TextAppearance.GupShup.Label"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/acceptButton"
        style="@style/Widget.GupShup.Button.Filled"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Accept"
        android:textAppearance="@style/TextAppearance.GupShup.Label"
        android:visibility="gone"
        android:layout_marginEnd="@dimen/spacing_sm"
        app:layout_constraintEnd_toStartOf="@id/rejectButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rejectButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Reject"
        android:textAppearance="@style/TextAppearance.GupShup.Label"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Inset Divider: 1dp Outline color, inset 84dp from left (aligns after 52dp avatar + spacing), not full-bleed -->
    <View
        android:id="@+id/itemDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/outline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="84dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
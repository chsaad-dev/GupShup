<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Circle shape for the profile image -->
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ReactionEmoji">
        <item name="android:textSize">26sp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="ProfileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#444</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="ProfileField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/edittext_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>



</resources>
